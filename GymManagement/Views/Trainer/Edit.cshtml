@using GymBusinessLogic.ViewModels.TrainerViewModel
@using GymDataAccsess.Models.Enums
@model UpdateTrainerViewModelcs




<div class="container">
    <main role="main" class="pb-3">

        <div class="container mt-4">
            <header class="mb-4">
                <h3 class="text-primary-color">Edit Trainer</h3>
                <p class="text-muted">Update trainer information</p>
            </header>

            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card shadow-sm border-0">
                        <div class="card-body p-4">
                            <div class="mb-4 pb-3 border-bottom">
                                <small class="text-muted d-block mb-1">Editing Profile For</small>
                                <h4 class="mb-0 text-black">Mohamed</h4>
                            </div>
                            @Html.ValidationMessage("InvalidData", new { @class = "text-danger" })
                            <form asp-controller="Trainer" asp-action="EditTrainer" method="post">
                                <input hidden readonly  asp-for="Name" />
                                <input hidden readonly name="id" value="@ViewBag.TrainerId " />
                                <!-- Personal Information -->
                                <div class="section-header mb-3">
                                    <h5 class="text-primary fw-bold">Personal Information</h5>
                                    <hr class="mt-2">
                                </div>
                                <div class="row g-3 mb-4">


                                    <div class="col-12 col-md-6">
                                        <label asp-for="Email" class="form-label">Email</label>
                                        <input asp-for="Email" type="email" class="form-control" />
                                        <span asp-validation-for="Email"></span>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <label asp-for="phone">Phone</label>
                                        <input asp-for="phone" type="text" class="form-control" />
                                        <span asp-validation-for="phone"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label asp-for="BuildingNumber">BuildingNumber</label>
                                        <input asp-for="BuildingNumber" type="number" class="form-control" />
                                        <span asp-validation-for="BuildingNumber"></span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label asp-for="Street">Street</label>
                                        <input asp-for="Street" type="text" class="form-control" />
                                        <span asp-validation-for="Street"></span>
                                        <div class="col-12 col-md-6">
                                            <label asp-for="City">City</label>
                                            <input asp-for="City" type="text" class="form-control" />
                                            <span asp-validation-for="City"></span>
                                        </div>
                                    </div>
                                </div>
                                    <!-- Professional Information -->
                                    <div class="section-header mb-3">
                                        <h5 class="text-primary fw-bold">Professional Information</h5>
                                        <hr class="mt-2">
                                    </div>
                                    <div class="row g-3">

                                        <div class="col-12">
                                            <label class="form-label fw-semibold">
                                                Specializations <span class="text-danger">*</span>
                                            </label>

                                            <div class="mb-3">
                                                <label class="form-label">Select Specialty</label>
                                                @foreach (var item in Enum.GetValues(typeof(Specialites)))
                                                {
                                                    <div class="form-check">
                                                        <input class="form-check-input"
                                                               asp-for="Specialization"
                                                               type="radio"
                                                               value="@item"
                                                               id="Specialty_@item" />
                                                        <label class="form-check-label" for="Specialty_@item">@item</label>
                                                    </div>
                                                }
                                                <span asp-validation-for="Specialization" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                                        <a asp-action="Index" class="btn btn-outline">
                                            <i class="bi bi-arrow-left me-1"></i>Cancel
                                        </a>
                                        <button type="submit" class="btn btn-fill">
                                            <i class="bi bi-check-lg me-1"></i>Update Trainer
                                        </button>
                                    </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>


    </main>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial"></partial>
}

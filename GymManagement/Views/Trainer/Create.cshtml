@using GymBusinessLogic.ViewModels.TrainerViewModel
@using GymDataAccsess.Models.Enums
@model CreatTrainerViewModel


<div class="container">
    <main role="main" class="pb-3">
        <div class="container mt-4">
            <header class="mb-4">
                <h3 class="text-primary-color">Add New Trainer</h3>
            </header>
            @Html.ValidationMessage("InvalidData", new { @class = "text-danger" })
            <form asp-controller="Trainer" asp-action="CreateMember" method="post">

                <!-- Trainer Info -->
                <div class="section-header mb-3">
                    <h5 class="text-primary fw-bold">Personal Information</h5>
                    <hr class="mt-2">
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="Name" class="form-label">Name</label>
                        <input asp-for="Name" type="text" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                        
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                        <span asp-validation-for="Email" ></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Phone">Phone</label>
                        <input asp-for="Phone" type="text" class="form-control" />
                        <span asp-validation-for="Phone"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="DateOfdBirth">DateOfBirth</label>
                        <input asp-for="DateOfdBirth" type="date" class="form-control" />
                        <span asp-validation-for="DateOfdBirth"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Gendar">Gender</label>
                        <select asp-for="Gendar" asp-items="Html.GetEnumSelectList<Gendar>()" class="form-select">
                            <option value="">-- Select Gender --</option>
                        </select>
                        <span asp-validation-for="Gendar" class="text-danger"></span>
                    </div>

                </div>
                <div class="section-header mb-3 mt-4">
                    <h5 class="text-primary fw-bold">Address Information</h5>
                    <hr class="mt-2">
                </div>
                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <label asp-for="BuildingNumber">BuildingNumber</label>
                        <input asp-for="BuildingNumber" type="number" class="form-control" />
                        <span asp-validation-for="BuildingNumber"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Street">Street</label>
                        <input asp-for="Street" type="text" class="form-control" />
                        <span asp-validation-for="Street"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="City">City</label>
                        <input asp-for="City" type="text" class="form-control" />
                        <span asp-validation-for="City"></span>
                    </div>
                </div>
                <!-- Professional Information -->
                <div class="section-header mb-3">
                    <h5 class="text-primary fw-bold">Professional Information</h5>
                    <hr class="mt-2">
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label fw-semibold">
                            Specializations <span class="text-danger">*</span>
                        </label>

                        <div class="mb-3">
                            <label class="form-label">Select Specialty</label>
                            @foreach (var item in Enum.GetValues(typeof(Specialites)))
                            {
                                <div class="form-check">
                                    <input class="form-check-input"
                                           asp-for="Specialites"
                                           type="radio"
                                           value="@item"
                                           id="Specialty_@item" />
                                    <label class="form-check-label" for="Specialty_@item">@item</label>
                                </div>
                            }
                            <span asp-validation-for="Specialites" class="text-danger"></span>
                        </div>

                    </div> 
                    <footer class="d-flex justify-content-end mt-4">
                        <button type="submit" class="btn btn-fill">Add</button>
                    </footer>

                </div>

            </form>


        </div>

    </main>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial"></partial>
}
